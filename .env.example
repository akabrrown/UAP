# Postgres. Local dev uses the private cluster started by `pnpm db:start`.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/uap

# Auth. AUTH_MODE=local issues JWTs from this API (development only, refused when NODE_ENV=production).
# AUTH_MODE=supabase verifies tokens issued by Supabase Auth with SUPABASE_JWT_SECRET.
AUTH_MODE=local
JWT_SECRET=replace-with-32-plus-random-bytes-hex
JWT_ISSUER=uap-api
JWT_TTL_SECONDS=900
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Application-level encryption key for supplier bank details, licence keys and TOTP secrets (32 bytes, base64).
FIELD_ENCRYPTION_KEY=replace-with-base64-32-bytes

# Cloudinary (file storage). Files are uploaded as type=authenticated and delivered through signed URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=uap
SIGNED_URL_TTL_SECONDS=300

# API
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=UPSA Assembly Unit <no-reply@example.edu.gh>

# Rate limits (Upstash Redis). Falls back to in-memory limiter when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observability
SENTRY_DSN=
